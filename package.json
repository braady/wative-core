{
  "name": "wative-core",
  "version": "2.3.0",
  "description": "Hyperscale crypto wallet management library — multi-workspace, multi-chain, originally designed for on-chain market makers",
  "type": "module",
  "main": "./dist/index.node.cjs",
  "module": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/index.node.d.ts",
          "default": "./dist/index.node.js"
        },
        "require": {
          "types": "./dist/index.node.d.cts",
          "default": "./dist/index.node.cjs"
        }
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./artifacts/evm": {
      "import": {
        "types": "./dist/artifacts/evm/index.d.ts",
        "default": "./dist/artifacts/evm/index.js"
      },
      "require": {
        "types": "./dist/artifacts/evm/index.d.cts",
        "default": "./dist/artifacts/evm/index.cjs"
      }
    },
    "./artifacts/svm": {
      "import": {
        "types": "./dist/artifacts/svm/index.d.ts",
        "default": "./dist/artifacts/svm/index.js"
      },
      "require": {
        "types": "./dist/artifacts/svm/index.d.cts",
        "default": "./dist/artifacts/svm/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braady/wative-core.git"
  },
  "bugs": {
    "url": "https://github.com/braady/wative-core/issues"
  },
  "homepage": "https://github.com/braady/wative-core#readme",
  "keywords": [
    "wallet",
    "keystore",
    "ethereum",
    "evm",
    "solana",
    "svm",
    "crypto",
    "hd-wallet",
    "multi-account"
  ],
  "author": "Brady <brady.c@hedgue.com>",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist/",
    "CHANGELOG.md",
    "examples/"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^2.2.0",
    "@solana/web3.js": "1.98.4",
    "bs58": "5.0.0",
    "ethers": "6.17.0",
    "micro-ed25519-hdkey": "0.1.2",
    "tslib": "2.6.2",
    "tweetnacl": "1.0.3"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^2.0.2"
  }
}
