{
  "name": "wative-core",
  "version": "2.0.4",
  "description": "Hyperscale crypto wallet management library — multi-workspace, multi-chain, originally designed for on-chain market makers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./artifacts/evm": {
      "types": "./dist/artifacts/evm/index.d.ts",
      "import": "./dist/artifacts/evm/index.js",
      "require": "./dist/artifacts/evm/index.cjs"
    },
    "./artifacts/svm": {
      "types": "./dist/artifacts/svm/index.d.ts",
      "import": "./dist/artifacts/svm/index.js",
      "require": "./dist/artifacts/svm/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:debug": "jest --detectOpenHandles --runInBand",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "packageManager": "pnpm@8.3.1",
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braady/wative-core.git"
  },
  "bugs": {
    "url": "https://github.com/braady/wative-core/issues"
  },
  "homepage": "https://github.com/braady/wative-core#readme",
  "keywords": [
    "wallet",
    "keystore",
    "ethereum",
    "evm",
    "solana",
    "svm",
    "crypto",
    "hd-wallet",
    "multi-account"
  ],
  "author": "Brady <brady.c@hedgue.com>",
  "license": "BUSL-1.1",
  "files": [
    "dist/",
    "tests/",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/web3.js": "1.91.8",
    "bs58": "5.0.0",
    "ethereumjs-wallet": "1.0.2",
    "micro-ed25519-hdkey": "0.1.2",
    "tslib": "2.6.2",
    "tweetnacl": "1.0.3",
    "web3": "1.7.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/bs58": "4.0.4",
    "@types/node": "24.2.0",
    "jest": "27.5.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
