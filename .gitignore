node_modules
*.log
.DS_Store

# Local publish tooling, delivered by the release sync. Not for publication.
# `.githooks/` is ignored because nothing but a local clone ever needs it.
#
# `check-example-suite.mjs` is deliberately NOT ignored: CI invokes it, so a
# fresh checkout must contain it or the example gate cannot run at all. Keeping
# it out of the npm tarball is the `files` allowlist's job, not this file's —
# and a root-level .mjs is already outside that allowlist.
.githooks/

# Captured test output. Node embeds ABSOLUTE paths in stack traces, so a failed
# run here holds the maintainer's local filesystem layout — and this is a
# publish-only repo where `git add -A` is the natural motion.
.test-output

# Sync provenance, written by scripts/sync-release-dev.mjs. It records the
# PRIVATE dev repo's commit SHA in `sourceCommit`, which must never reach the
# public repo. It was previously held back only by `.git/info/exclude`, which is
# per-clone and not shared — so a fresh clone plus `git add -A` would have
# published it. An ignore rule that only exists in one working copy is not a
# release control.
.wative-core-build-meta.json

# Credentials. `npm publish` runs from THIS repo, so a secret-bearing file sits
# in the directory the publish guide tells you to `git add .` in — and this repo
# is public. The commit gate cannot help: .githooks/pre-commit only invokes
# check-dist.mjs when `dist/` is staged, and that script walks only dist/.
# These lines are the sole mechanism.
#
# `.env*` is here for the same reason as `.npmrc`, not because anything writes
# it: a maintainer wiring publish automation puts NPM_TOKEN in a root .env.
.npmrc
.env
.env.*

# Lockfiles. The release CI runs `npm install` AT THIS ROOT
# (.github/workflows/ci.yml), so reproducing it locally leaves a lockfile that
# `git add .` would publish along with the resolved registry hosts.
package-lock.json
yarn.lock

# Editor and OS state that can hold PRE-BUILD content. VS Code Local
# History keeps whole copies of every saved file inside the workspace, and vim
# swap files hold entire buffers — in a repo whose protection model is "only
# built output ships", these are the direct vector.
.history/
.idea/
.vscode/
*.swp
*.swo

# `npm pack` output. The guide runs pack from here to inspect the tarball, and
# the tarball contains the whole published surface.
*.tgz

# Scratch dir from the browser lane. `scripts/browser-e2e.mjs` mkdtemps it under
# WATIVE_E2E_ROOT, which the publish guide points AT THIS REPO — so a run
# interrupted before its `finally` leaves a harness plus a full esbuild bundle
# here. The commit gate cannot catch it: check-dist.mjs walks only `dist/`.
#
# `.entry-probe-*/` is deliberately NOT listed. Its only producer,
# tests/packaging/entry-resolution.test.ts, roots at the dev repo and is never
# synced, so the pattern would be dead here — and a dead ignore pattern is
# exactly how a probe dir reached commit dc4aad9.
.browser-e2e-*/
