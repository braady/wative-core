node_modules
*.log
.DS_Store

# Captured test output. Node embeds absolute paths in stack traces.
.test-output

# Credentials. `npm publish` runs from this repo and this repo is public, so a
# secret-bearing file would sit in the directory you `git add .` in.
# `.env*` is listed for the same reason as `.npmrc`: publish automation puts a
# registry token in a root .env.
.npmrc
.env
.env.*

# Lockfiles. CI installs at this root, so reproducing it locally leaves a
# lockfile that `git add .` would publish along with its resolved hosts.
package-lock.json
yarn.lock

# Editor and OS state that can hold unpublished content. VS Code Local History
# keeps whole copies of every saved file inside the workspace, and vim swap
# files hold entire buffers.
.history/
.idea/
.vscode/
*.swp
*.swo

# `npm pack` output — the tarball holds the whole published surface.
*.tgz

# Scratch dir from the browser test lane, left behind by an interrupted run.
# No pattern is listed here for anything this repo cannot itself produce: a
# dead ignore rule reads as a closed door while standing open, which is how a
# scratch directory once reached a commit.
.browser-e2e-*/
